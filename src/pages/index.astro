---
import Cursor from "../3d/cursor.tsx";
import MainLayout from "@/layouts/mainLayout.astro";
import {CodeXmlIcon, MusicIcon, SportShoeIcon, PlusIcon} from "@lucide/astro";
import HomeScreenNav from "@/components/homeScreenNav.astro";
---


<script>
    import {gsap} from "gsap";
    import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";

    gsap.registerPlugin(ScrambleTextPlugin);

    gsap.from("#title", {
        scrambleText: "yesac kenosam",
        duration: 1,
    }).then(() => {
        gsap.to("#header", {
            height: "9vh",
            overflowY: "auto",
            delay: 1
        })
    }).then(() => {
        gsap.to(".gradient", {
            top: 0,
            duration: 1,
            delay: 0.5
        })
    })

    gsap.to(".move",{
        top: -1.2 * 250 + "lh",
        duration: 200,
        repeat: -1,
        ease: "linear",
    })

    gsap.to(".gradient",{
        duration: 10,
        repeat: -1,
        ease: "linear",
        backgroundPositionX: "100%"
    })
</script>

<MainLayout>
    <div class="absolute top-[-1000px] h-100 bg-gradient-to-r from-red-500 via-purple-500 to-blue-500 w-full z-[-1] gradient">
        <div class="h-100 bg-gradient-to-b to-background">
            &nbsp;
        </div>
    </div>
    <div class="overflow-y-hidden">
        <div class="p-3 h-[101vh] flex items-center border-b-1 justify-center z-10" id="header">
            <div class=" gradient w-full flex items-center bg-size-[50%]">
                <a href="/" class="w-full text-center">
                    <h1 class="text-5xl w-full text-center" id="title">Casey Masonek</h1>
                </a>
            </div>
        </div>
        <div class="flex flex-row w-full h-[91vh] relative overflow-clip">
            <div class="absolute top-0 w-1/2 move z-0 overflow-clip">
                <div class="flex w-[140%] rotate-0 left-[-3px] flex-wrap items-center opacity-5">
                    {Array.from({length: 1000}).map((item) => {
                        return ["Programmer", "Musician", "Athlete", "Learner", "Friend"].map(item => (
                                <span class="text-xl text-black dark:text-white">{item}&nbsp;·&nbsp;</span>
                        ))
                    })}
                </div>
            </div>
            <div class="w-1/2 flex justify-center items-center">
                <Cursor client:only={"react"} />
            </div>
            <div class="border-l-1 p-10 w-1/2">
                <div class="h-1/2 overflow-y-scrol">
                    <h2 class="text-3xl mb-3">Hi, I'm Casey!</h2>

                    <p class="text-muted-foreground">
                        I'm a programmer, musician, and lifelong learner. I love to explore topics that interest me and make stuff I think is cool. So far, I’ve focused on game and web development. Every year, my game development team and I compete in a statewide game dev contest. I’m the lead developer of the team, and I’ve helped mentor the newer programmers. In terms of web development, I’ve spent a lot of my free time learning and making projects with various frontend and backend frameworks (Ruby on Rails, Next.js, Astro, SvelteKit, Phoenix, to name a few). Recently, I’ve been focusing on making projects with real-world impact. I love the feeling of creating something that helps people and putting it out in the world, and I hope to continue this at a college level.
                    </p>
                </div>
                <hr class="my-5" />

                <div class="w-full grow grid flex-row grid-cols-1 gap-5">
                    <HomeScreenNav title="View Projects" Icon={CodeXmlIcon} path="/programming">
                        Click to explore my favorite projects!
                    </HomeScreenNav>
                </div>
            </div>
        </div>
    </div>
</MainLayout>

